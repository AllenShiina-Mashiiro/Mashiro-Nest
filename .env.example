# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_PORT=3000

# Authentication — set your own secrets before deployment
AUTH_SECRET=
ADMIN_NAME=Site Admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@mashiro.dev
ADMIN_PASSWORD=

# PostgreSQL is REQUIRED in local development and production.
# Host Node.js uses 127.0.0.1; Docker Compose overrides this with db:5432.
DATABASE_URL=postgresql://mashiro:CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD@127.0.0.1:5432/mashiro?schema=public
POSTGRES_USER=mashiro
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=mashiro
DB_PORT=5432

# Redis is optional outside Docker Compose.
REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6379
# CACHE_TTL=30
# CACHE_PREFIX=mashiro
# CACHE_DISABLED=0

# S3-compatible storage (recommended for serverless deployments)
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_PUBLIC_URL=
# S3_FORCE_PATH_STYLE=false

# Optional
# DISABLE_IP_LOCATION=1
