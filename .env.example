# ---------------------------------------------------------------------------
# Public site URL
# Local: http://localhost:3000
# Production: https://your-domain.example
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_PORT=3000

# ---------------------------------------------------------------------------
# Authentication (required for production)
# Generate a secret with: openssl rand -base64 48
# Use a unique password of at least 12 characters for the administrator.
# ---------------------------------------------------------------------------
AUTH_SECRET=
ADMIN_NAME=Site Admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# PostgreSQL
# Leave DATABASE_URL empty for local JSON mode.
# For Docker Compose, app DATABASE_URL is assembled from the POSTGRES_* values.
# For npm run dev on your host, use localhost in DATABASE_URL.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://mashiro:replace-me@127.0.0.1:5432/mashiro?schema=public
POSTGRES_USER=mashiro
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=mashiro
DB_PORT=5432

# ---------------------------------------------------------------------------
# Redis (optional outside Docker Compose)
# Compose configures REDIS_URL=redis://redis:6379 for the app automatically.
# ---------------------------------------------------------------------------
# REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6379
# CACHE_TTL=30
# CACHE_PREFIX=mashiro
# CACHE_DISABLED=0

# ---------------------------------------------------------------------------
# S3-compatible object storage (recommended for Vercel/serverless deployments)
# Supported providers include AWS S3, Cloudflare R2, MinIO and compatible APIs.
# Local disk storage is used when STORAGE_DRIVER=local or S3 is not configured.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_PUBLIC_URL=
# S3_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------------------
# Optional feature switches
# ---------------------------------------------------------------------------
# BLOG_DEMO=1
# DISABLE_IP_LOCATION=1
