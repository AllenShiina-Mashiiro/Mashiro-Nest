# ---------------------------------------------------------------------------
# 站点
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# 数据库（PostgreSQL）
# 留空 = 演示模式：直接读取 src/content/posts 下的 Markdown，无需任何服务。
# 填上并执行 `npm run db:push && npm run db:seed` 后切换到数据库模式。
# ---------------------------------------------------------------------------
# 方式一：项目自带的本地集群（scripts/dev-db.ps1 start，端口 55432，trust 认证）
# DATABASE_URL="postgresql://postgres@127.0.0.1:55432/mashiro?schema=public&connect_timeout=3"
# 方式二：你自己的 PostgreSQL
# DATABASE_URL="postgresql://mizuki:mizuki@localhost:5432/mizuki?schema=public"

# ---------------------------------------------------------------------------
# 认证
# ---------------------------------------------------------------------------
# 生产环境务必替换：openssl rand -base64 32
AUTH_SECRET=dev-only-secret-please-change-me-1234567890

# 演示模式下的登录账号；也是 seed 时创建的管理员账号
ADMIN_NAME=AllenShiina
ADMIN_USERNAME=AllenShiina
ADMIN_EMAIL=admin@mizuki.dev
ADMIN_PASSWORD=mizuki

# ---------------------------------------------------------------------------
# Redis（可选）
# 不配置时自动降级为进程内缓存；阅读量计数同样可用。
# ---------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379
# CACHE_TTL=60
# CACHE_DISABLED=0

# ---------------------------------------------------------------------------
# 对象存储（可选，兼容 S3 / MinIO / R2 / OSS）
# 不配置时媒体库只展示配置说明，文章仍可使用本地 /images 路径。
# ---------------------------------------------------------------------------
# S3_BUCKET=mizuki-media
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_PUBLIC_URL=
# S3_FORCE_PATH_STYLE=false
# STORAGE_DRIVER=local|s3   # 不填则「有 S3 配置就用 S3，否则本地」

# 强制演示模式（即使配置了数据库）
# BLOG_DEMO=1

# 关闭关于页的访客 IP 定位（默认开启，失败会自动降级）
# DISABLE_IP_LOCATION=1

